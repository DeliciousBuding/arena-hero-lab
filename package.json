{
  "name": "arena-hero-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic simulation, benchmarking, research, replay, and leaderboard tooling for Arena Hero.",
  "scripts": {
    "dev": "pnpm --filter @arena-hero/leaderboard-web dev",
    "build": "pnpm --filter @arena-hero/leaderboard-web build",
    "preview": "pnpm --filter @arena-hero/leaderboard-web preview",
    "lint": "pnpm --filter @arena-hero/leaderboard-web lint",
    "deploy:gh-pages": "pnpm --filter @arena-hero/leaderboard-web deploy:gh-pages",
    "convert:oracle": "pnpm --filter @arena-hero/leaderboard-web convert:oracle"
  },
  "packageManager": "pnpm@10.32.1"
}
