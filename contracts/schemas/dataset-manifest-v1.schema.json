{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arena.local/schemas/dataset-manifest-v1.schema.json",
  "title": "Arena ML dataset manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "datasetId",
    "createdAt",
    "sampleSchema",
    "format",
    "rulesVersion",
    "rulesManifestHash",
    "sourceCommit",
    "engine",
    "tickRange",
    "sourceRefs",
    "processRunIds",
    "runIds",
    "counts",
    "labelSpec",
    "artifacts",
    "datasetHash"
  ],
  "properties": {
    "schema": { "const": "dataset-manifest-v1" },
    "datasetId": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "sampleSchema": { "const": "ml-sample-v1" },
    "format": { "const": "jsonl" },
    "rulesVersion": { "type": "string", "minLength": 1 },
    "rulesManifestHash": { "$ref": "#/$defs/sha256" },
    "sourceCommit": { "$ref": "#/$defs/sourceCommit" },
    "engine": { "$ref": "#/$defs/engine" },
    "tickRange": { "$ref": "#/$defs/tickRange" },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sourceRef" }
    },
    "processRunIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "runIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "counts": { "$ref": "#/$defs/counts" },
    "labelSpec": { "$ref": "#/$defs/labelSpec" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "datasetHash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^(?:sha256:)?[0-9a-f]{64}$"
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "enum": ["legacy-ts", "legacy-rs"] },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "tickRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first", "last"],
      "properties": {
        "first": { "type": "integer", "minimum": 1 },
        "last": { "type": "integer", "minimum": 1 }
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schema", "id", "uri", "sha256"],
      "properties": {
        "kind": {
          "enum": [
            "calibration-case",
            "sim-record",
            "telemetry",
            "scenario",
            "policy",
            "dataset-manifest"
          ]
        },
        "schema": { "type": ["string", "null"], "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "uri": { "type": ["string", "null"], "format": "uri-reference" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "samples",
        "liveSamples",
        "simSamples",
        "completeLabelWindows",
        "incompleteLabelWindows"
      ],
      "properties": {
        "samples": { "type": "integer", "minimum": 0 },
        "liveSamples": { "type": "integer", "minimum": 0 },
        "simSamples": { "type": "integer", "minimum": 0 },
        "completeLabelWindows": { "type": "integer", "minimum": 0 },
        "incompleteLabelWindows": { "type": "integer", "minimum": 0 }
      }
    },
    "labelSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "netWindowTicks",
        "deathWindowTicks",
        "coreRiskWindowTicks",
        "runBoundary"
      ],
      "properties": {
        "netWindowTicks": { "const": 20 },
        "deathWindowTicks": { "const": 20 },
        "coreRiskWindowTicks": { "const": 50 },
        "runBoundary": { "const": "truncate-and-mark-incomplete" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "mediaType",
        "recordSchema",
        "sha256",
        "bytes",
        "recordCount",
        "tickRange"
      ],
      "properties": {
        "path": { "type": "string", "minLength": 1, "format": "uri-reference" },
        "mediaType": { "const": "application/x-ndjson" },
        "recordSchema": { "const": "ml-sample-v1" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 0 },
        "recordCount": { "type": "integer", "minimum": 0 },
        "tickRange": { "$ref": "#/$defs/tickRange" }
      }
    }
  }
}
