{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arena.local/schemas/sim-record-v1.schema.json",
  "title": "Arena Rust synthetic transition record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "recordId",
    "before",
    "plan",
    "after",
    "outcome",
    "semanticStatus",
    "unknowns",
    "provenance"
  ],
  "properties": {
    "schema": { "const": "sim-record-v1" },
    "recordId": { "type": "string", "minLength": 1 },
    "before": {
      "$ref": "sim-calibration-case-v1.schema.json#/$defs/observation"
    },
    "plan": {
      "$ref": "sim-calibration-case-v1.schema.json#/$defs/plan"
    },
    "after": {
      "$ref": "sim-calibration-case-v1.schema.json#/$defs/observation"
    },
    "outcome": { "$ref": "#/$defs/outcome" },
    "semanticStatus": { "enum": ["conclusive", "inconclusive"] },
    "unknowns": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "unknowns": { "type": "array", "minItems": 1 } },
        "required": ["unknowns"]
      },
      "then": {
        "properties": { "semanticStatus": { "const": "inconclusive" } }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^(?:sha256:)?[0-9a-f]{64}$"
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "arena-rs" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schema", "id", "uri", "sha256"],
      "properties": {
        "kind": {
          "enum": [
            "calibration-case",
            "sim-record",
            "telemetry",
            "scenario",
            "policy",
            "dataset-manifest"
          ]
        },
        "schema": { "type": ["string", "null"], "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "uri": { "type": ["string", "null"], "format": "uri-reference" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rulesVersion",
        "rulesManifestHash",
        "sourceCommit",
        "engine",
        "processRunId",
        "runId",
        "tick",
        "seed",
        "source",
        "observationScope",
        "opponentPlans",
        "sourceRefs"
      ],
      "properties": {
        "rulesVersion": { "type": "string", "minLength": 1 },
        "rulesManifestHash": { "$ref": "#/$defs/sha256" },
        "sourceCommit": { "$ref": "#/$defs/sourceCommit" },
        "engine": { "$ref": "#/$defs/engine" },
        "processRunId": { "type": "string", "minLength": 1 },
        "runId": { "type": "string", "minLength": 1 },
        "tick": { "type": "integer", "minimum": 1 },
        "seed": { "type": "integer" },
        "source": { "const": "sim" },
        "observationScope": { "const": "private-player-projection" },
        "opponentPlans": { "const": "not-included" },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sourceRef" }
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coreResourceDelta",
        "workerDelta",
        "deaths",
        "eventTypes"
      ],
      "properties": {
        "coreResourceDelta": { "type": "integer" },
        "workerDelta": { "type": "integer" },
        "deaths": { "type": "integer", "minimum": 0 },
        "eventTypes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
